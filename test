  let currentBlobUrl = null;

  async function bacaBuku(id) {
    const item = getData().find(b => b.id === id);
    if (!item) return;
    document.getElementById('pdfTitle').textContent = '📖 ' + item.judul;

    if (currentBlobUrl) {
      URL.revokeObjectURL(currentBlobUrl);
      currentBlobUrl = null;
